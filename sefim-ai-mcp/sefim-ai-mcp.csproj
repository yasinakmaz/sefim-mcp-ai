<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>SefimMcp</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64;linux-x64;linux-arm64;linux-musl-x64</RuntimeIdentifiers>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackAsTool>true</PackAsTool>
        <PackageType>McpServer</PackageType>
        <SelfContained>true</SelfContained>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageId>SefimSaleMcpServer</PackageId>
        <PackageVersion>0.1.0-beta</PackageVersion>
        <PackageTags>AI; MCP; server; stdio</PackageTags>
        <Description>Sefim Sale Mcp Server Program</Description>
        <PublishAot>true</PublishAot>
        <OptimizationPreference>Speed</OptimizationPreference>
        <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <Company>YasinAkmaz</Company>
        <Product>SefimSaleMcpServer</Product>
    </PropertyGroup>

    <ItemGroup>
        <None Include=".mcp\server.json" Pack="true" PackagePath="/.mcp/" />
        <None Include="..\README.md" Link="README.md" Pack="true" PackagePath="" />
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Update="appsettings.Local.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </None>
        <None Include="..\\knowledge\\README.md" Link="knowledge\\README.md" Pack="true" PackagePath="knowledge/" />
        <None Include="..\\knowledge\\templates\\**\\*" Link="knowledge\\templates\\%(RecursiveDir)%(Filename)%(Extension)" Pack="true" PackagePath="knowledge/templates/%(RecursiveDir)" />
        <None Update="knowledge.pack" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('knowledge.pack')" />
        <None Remove="..\\knowledge\\private\\**\\*" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
        <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Models\SefimmContext.cs" />
    </ItemGroup>
    
    <ItemGroup>
        <Using Include="ModelContextProtocol.Server" />
        
        <Using Include="Microsoft.Extensions.Logging" />
        <Using Include="Microsoft.Extensions.Hosting" />
        <Using Include="Microsoft.Extensions.DependencyInjection" />
        <Using Include="Microsoft.Extensions.Configuration" />
        
        <Using Include="System.ComponentModel" />
        <Using Include="System.Text.Json.Serialization" />
        
        <Using Include="SqlService.Infrastructure.Extensions" />
        <Using Include="SqlService.Infrastructure.Services" />
        <Using Include="SqlService.Core.Attributes" />
        <Using Include="SqlService.Core.Interfaces"/>
        
        <Using Include="SefimMcp.Models" />
        <Using Include="SefimMcp.Models.system" />
        <Using Include="SefimMcp.Interfaces" />
        <Using Include="SefimMcp.Repository" />
        <Using Include="SefimMcp.Helper" />
        <Using Include="SefimMcp.Application.Policies" />
        <Using Include="SefimMcp.Infrastructure.Metadata" />
        <Using Include="SefimMcp.Knowledge.Models" />
        <Using Include="SefimMcp.Knowledge.Authoring" />
        <Using Include="SefimMcp.Knowledge.Runtime" />
        <Using Include="SefimMcp.Mcp.Resources" />
        <Using Include="SefimMcp.Mcp.Dtos" />
        <Using Include="SefimMcp.Mcp.Tools" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\SERVICES\SqlService\SqlService.csproj" />
    </ItemGroup>

    <!--
        Templates are authoring skeletons and are shipped in the NuGet package as plain text.
        Real business content belongs in knowledge/private, which is packed into the encrypted knowledge.pack.
        This target fails the build if anyone writes prose into a template, because that prose would ship unencrypted.
    -->
    <Target Name="VerifyKnowledgeTemplatesAreBlank" BeforeTargets="Pack;Publish">
        <ItemGroup>
            <KnowledgeTemplateFile Include="..\knowledge\templates\**\*.md" />
        </ItemGroup>
        <ReadLinesFromFile File="%(KnowledgeTemplateFile.FullPath)">
            <Output TaskParameter="Lines" ItemName="KnowledgeTemplateLine" />
        </ReadLinesFromFile>
        <ItemGroup>
            <!-- Allowed: blank lines, headings, frontmatter keys, frontmatter fences and USER placeholder comments. -->
            <KnowledgeTemplateProse
                Include="@(KnowledgeTemplateLine)"
                Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '^\s*(#{1,6}\s.*|---|(kind|id|status|exposure|title|summary|aliases|max_rows|version):.*|\|.*\||([-*]\s+)?(\*\*[^*]+\*\*:?)?\s*(&lt;!--.*--&gt;)?)\s*$'))" />
        </ItemGroup>
        <Error
            Condition="'@(KnowledgeTemplateProse)' != ''"
            Code="SEFIM001"
            Text="knowledge/templates contains authored content and would ship unencrypted. Move it to knowledge/private and run 'knowledge pack'. Offending line(s): @(KnowledgeTemplateProse->'%(Identity)', ' / ')" />
    </Target>

    <!-- A published server without a pack silently loses every business meaning, so fail loudly instead. -->
    <Target Name="VerifyKnowledgePackPresent" BeforeTargets="Publish" Condition="'$(AllowMissingKnowledgePack)' != 'true'">
        <Error
            Condition="!Exists('$(MSBuildProjectDirectory)\knowledge.pack')"
            Code="SEFIM002"
            Text="knowledge.pack is missing next to the project. Run 'dotnet run -- knowledge pack --output sefim-ai-mcp/knowledge.pack' with SEFIM_KNOWLEDGE_KEY set, or publish with -p:AllowMissingKnowledgePack=true to accept a server with no business knowledge." />
    </Target>

    <!-- Last line of defence: plaintext knowledge must never reach the publish output. -->
    <Target Name="VerifyNoPlaintextKnowledgeInPublish" AfterTargets="ComputeResolvedFilesToPublishList">
        <ItemGroup>
            <LeakedKnowledgeFile
                Include="@(ResolvedFileToPublish)"
                Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').Contains('knowledge/private')) Or $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').EndsWith('.template.md'))" />
        </ItemGroup>
        <Error
            Condition="'@(LeakedKnowledgeFile)' != ''"
            Code="SEFIM003"
            Text="Plaintext knowledge would be published: @(LeakedKnowledgeFile->'%(RelativePath)', ', ')" />
    </Target>

</Project>
